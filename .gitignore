# build output: regenerated by tools\build.ps1 from src\ (merged tables, packed archives, the .gt3ext add-on, temp files)
build/
tools/build_log.txt
# per-machine
*.log
Thumbs.db
desktop.ini
# files the Claude desktop app drops into the folder
Claude outputs/
# game data unpacked for study (Graviteam's own files - not ours to publish) and raw downloads that tools\ can refetch
docs/m10_t3485/mf_rows/
docs/m10_t3485/gtos_samples/
docs/m10_t3485/sf_cfg/
docs/m12_terrain/samples/
docs/m12_terrain/test/
docs/m12_terrain/dem/*.tif
docs/m12_terrain/period/tiles_rkka100k/
docs/m12_terrain/period/Zrzut ekranu*
docs/m12_terrain/period/rkka100k_block.jpg
*.pyc
# vehicle meshes assembled from game parts (Graviteam geometry, not ours to publish) - rebuild with tools\m13\*_mesh.py
src/m13_vehicles/mfo_gos/*.mesh.loc_def.bin
# textures made from the user's purchased M3 Lee and SU-76 models (licensed to the user, not to be published)
src/m13_vehicles/mfo_gos/*.texture.loc_def.bin
# the optional IS-2: same reason, a paid model
src/m14_is2/mfo_gos/*.bin
# the optional T-34-85: its turret is from a paid model
src/m15_t3485/mfo_gos/*.bin
